<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>

  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <file value="D:\CTSLite\Logs\SFTPInINW\SFTPInINW.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="'_'yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %level %logger - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="RollingFileAppender" />
    </root>
  </log4net>

  <appSettings>
    <add key="SLEEP_MS" value="3000" />
    <add key="HOLD_BEFORE_SUCC_DOWNLOAD_MS" value="3000" />
    <!-- Tectia -->
    <add key="SFTP_PROGRAM" value="sftpg3" />
    <add key="SFTP_HOST" value="172.19.224.13" />
    <add key="SFTP_PORT" value="51722" />
    <add key="SFTP_USER" value="sftpuser" />
    <add key="SFTP_KEY" value="C:\Users\USUPPORT01\AppData\Roaming\SSH\UserKeys\key_USUPPORT01_RC2UDBS-TX" />

    <!-- Remote (bank CM) folder -->
    <add key="REMOTE_DIR" value="Inward" />
    <add key="REMOTE_PROCESSED_DIR" value="Inward/Processed" />
    <add key="DELETE_AFTER_DOWNLOAD" value="false" />

    <!-- Local: PGPIn-INW_Listener reads from \\CTSLite\Inward\<date> -->
    <add key="LOCAL_DEST_ROOT" value="D:\CTSLite\Inward" />
    <add key="DATE_FOLDER_FORMAT" value="yyyyMMdd" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>